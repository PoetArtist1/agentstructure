# ─── Servidor HTTP + WebSocket ────────────────────────────────────────────────
# Puerto donde escucha el servidor (HTTP y WS comparten el mismo puerto)
PORT=3500

# ─── Autenticación App → Servidor (capa HTTP) ────────────────────────────────
# API Key que debe enviar la App en el header X-Api-Key para poder hacer peticiones.
# Sin esta clave, cualquier petición a /query/* es rechazada con 401.
# Genera una clave segura para producción (ej. con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
API_KEY=mi-clave-de-api-super-segura-cambiar-en-produccion

# ─── Timeout de respuesta del agente ─────────────────────────────────────────
# Tiempo máximo (en milisegundos) que el servidor espera a que un agente
# responda antes de devolver un error 504 a la App. Default: 30 segundos.
QUERY_TIMEOUT_MS=30000

# ─── Configuración de Caché en Memoria ───────────────────────────────────────
# Tiempo de vida por defecto (en segundos) de las consultas en la memoria del servidor.
# Si se establece en 0 o no se define, la caché estará desactivada.
CACHE_DEFAULT_TTL=60

